# syntax=docker/dockerfile:1.7
FROM golang:1.26.3-alpine AS build
RUN apk add --no-cache ca-certificates git
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux go build \
        -trimpath \
        -ldflags "-s -w -X main.Version=${VERSION}" \
        -o /out/natlas-server ./cmd/natlas-server && \
    CGO_ENABLED=0 GOOS=linux go build \
        -trimpath \
        -ldflags "-s -w -X main.Version=${VERSION}" \
        -o /out/natlas-admin ./cmd/natlas-admin

# natlas-admin is shipped alongside natlas-server so operators can run admin
# subcommands inside the cluster without standing up a separate image:
#   docker compose exec server /natlas-admin user create --admin you@example.com
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/natlas-server /natlas-server
COPY --from=build /out/natlas-admin /natlas-admin
EXPOSE 5001
USER nonroot:nonroot
ENTRYPOINT ["/natlas-server"]
